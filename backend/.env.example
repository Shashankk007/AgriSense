PORT=5555
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/agrisense
CLIENT_URL=http://localhost:5176

ACCESS_TOKEN_SECRET=<long-random-string>
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=<another-long-random-string>
REFRESH_TOKEN_EXPIRY=7d

GOOGLE_CLIENT_ID=<google-oauth-client-id>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password-reset emails (Gmail): enable 2-step verification, then create an App Password.
EMAIL_USER=you@gmail.com
EMAIL_PASS=<16-character-app-password>

# ML service (disease/pest prediction). ML_ADMIN_KEY must equal the one in ml-service/.env
FAST_API_URL=http://localhost:8000
ML_ADMIN_KEY=<same-long-random-string-as-ml-service>
