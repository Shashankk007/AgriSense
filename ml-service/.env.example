# Same cluster/database the Node backend uses (farms are read from the database named in the URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/agrisense
DATABASE_NAME=agrisense_ai
# Optional: override the farms database if it differs from the one in MONGODB_URI
# MONGO_DB_NAME=agrisense

GOOGLE_API_KEY=<gemini-api-key>
# Run `python check_models.py` to list models your key can use
LLM_MODEL=gemini-3.6-flash
# Fallback if the primary is overloaded (blank to disable)
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768   # must equal numDimensions of your Atlas vector indexes
# GROQ_API_KEY=            # optional: faster memory extraction
# GROQ_MODEL=openai/gpt-oss-20b

CORS_ORIGIN=http://localhost:5176

# Required to use /memory/* and /knowledge/upload (send as X-Admin-Key header)
ML_ADMIN_KEY=<long-random-string>

# Google Earth Engine (NDVI)
GEE_INIT_MODE=local            # or service_account
# GEE_SERVICE_ACCOUNT=
# GEE_PRIVATE_KEY_FILE=
# GEE_PRIVATE_KEY_JSON=
