# ============================================
# AgriSense ML Service — Environment Variables
# ============================================

# Google Gemini API Key (from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# MongoDB Atlas Connection
MONGODB_URI=your_mongodb_uri_here
DATABASE_NAME=agrisense_ai

# Collection Names
KNOWLEDGE_COLLECTION=knowledge_base
MEMORY_COLLECTION=user_memories
CONVERSATION_COLLECTION=conversations

# Vector Search Index Names
KNOWLEDGE_INDEX_NAME=knowledge_vector_index
MEMORY_INDEX_NAME=memory_vector_index

# LLM Configuration
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/embedding-001
LLM_TEMPERATURE=0.3

# Server
ML_SERVICE_PORT=8000
